{
  "format": "nexuscut-caption-style/v1",
  "name": "Hormozi Bold Glow",
  "author": "NexusCut Marketplace",
  "usage": "Apply after generating captions. Use yellow for emphasis words and white for supporting words.",
  "captionStyle": {
    "fontFamily": "Roboto Black, sans-serif",
    "fontSize": 80,
    "fontWeight": 900,
    "textTransform": "uppercase",
    "textAlign": "center",
    "color": "#FFFFFF",
    "outlineWidth": 8,
    "outlineColor": "#000000",
    "textShadow": true,
    "shadowColor": "rgba(0,0,0,0.80)",
    "shadowBlur": 15,
    "x": 50,
    "y": 72,
    "animation": { "type": "word_by_word_pop", "durationMs": 150, "scaleFrom": 0.8, "scaleTo": 1 }
  },
  "emphasis": { "color": "#FFFF00", "recommendedWords": "numbers, pain points, outcomes, action verbs" }
}
