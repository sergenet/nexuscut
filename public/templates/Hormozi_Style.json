{
  "preset_name": "Hormozi Bold Glow",
  "software_compatibility": ["NexusCut", "Premiere Pro (via PRFPSET converted)"],
  "typography": {
    "font_family": "Roboto Black, sans-serif",
    "font_weight": 900,
    "text_transform": "uppercase",
    "font_size": "80px",
    "line_height": 1.1
  },
  "colors": {
    "primary": "#FFFF00",
    "secondary": "#FFFFFF",
    "outline": "#000000"
  },
  "effects": {
    "stroke_width": "8px",
    "drop_shadow": {
      "color": "rgba(0, 0, 0, 0.8)",
      "blur": "15px",
      "offset_y": "10px",
      "offset_x": "0px"
    }
  },
  "animation": {
    "type": "word_by_word_pop",
    "scale_start": 0.8,
    "scale_end": 1.0,
    "duration_ms": 150,
    "easing": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
  },
  "alignment": {
    "vertical": "center",
    "horizontal": "center",
    "margin_bottom": "25%"
  }
}
